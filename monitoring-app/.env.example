# Copy this file to .env and adjust values before running docker compose
# .env is gitignored — never commit real credentials

# PostgreSQL
POSTGRES_USER=monitor
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=monitordb

# Backend
DATABASE_URL=postgresql+asyncpg://monitor:change_me_in_production@db:5432/monitordb
SQLALCHEMY_ECHO=false

# Frontend (leave empty to use the Nginx proxy; set to backend's public URL in production)
REACT_APP_API_URL=
